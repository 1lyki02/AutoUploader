# Generate secrets:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://autouploader:autouploader@localhost:5432/autouploader
SERVER_API_TOKEN=
CREDENTIALS_MASTER_KEY=

# Cloudflare R2 S3 credentials and bucket.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autouploader

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
CAMOUFOX_OS=linux

WORKER_ENABLED=true
WORKER_CONCURRENCY=2
LEASE_SECONDS=900
VIDEO_RETENTION_HOURS=48
UPLOAD_RETENTION_HOURS=168
