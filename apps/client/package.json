{
  "name": "@autouploader/client",
  "private": true,
  "version": "0.1.8",
  "description": "ROAD — публикации по расписанию",
  "repository": {
    "type": "git",
    "url": "https://github.com/1lyki02/AutoUploader.git"
  },
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:scheduler": "node --test tests/scheduler.test.mjs",
    "test:license": "tsx --test tests/license.test.mjs",
    "prepare:instagram-worker": "node scripts/prepare-instagram-worker.mjs",
    "ensure:license-config": "node scripts/ensure-license-config.mjs",
    "package": "pnpm ensure:license-config && pnpm prepare:instagram-worker && pnpm build && electron-builder --win",
    "package:mac": "pnpm ensure:license-config && pnpm prepare:instagram-worker && pnpm build && electron-builder --mac",
    "package:linux": "pnpm ensure:license-config && pnpm prepare:instagram-worker && pnpm build && electron-builder --linux",
    "publish:github": "pnpm ensure:license-config && pnpm prepare:instagram-worker && pnpm build && electron-builder --publish always",
    "publish:github:mac": "pnpm ensure:license-config && pnpm prepare:instagram-worker && pnpm build && electron-builder --mac --publish always",
    "publish:github:mac-ci": "node scripts/trigger-macos-release.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@autouploader/automation": "workspace:*",
    "@autouploader/shared": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-sqlite3": "^11.7.0",
    "camoufox-js": "^0.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.2",
    "electron-updater": "^6.3.9",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^1.27.0",
    "patchright": "^1.49.0",
    "playwright-core": "1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "2.1.8",
    "rcedit": "5.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
