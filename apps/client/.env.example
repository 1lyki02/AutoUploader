# Optional for local development. In the shipped app users enter these in Settings → YouTube Data API.
# YouTube: create a Google Cloud OAuth Desktop client and paste ID/secret.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional: force a Chrome/Edge executable for TikTok browser automation.
TIKTOK_BROWSER_EXECUTABLE=

# Optional: default proxy for Instagram browser sessions (saved on connect).
INSTAGRAM_PROXY_SERVER=
INSTAGRAM_PROXY_USERNAME=
INSTAGRAM_PROXY_PASSWORD=

# Optional remote scheduler. Required for publishing while this PC is offline.
AUTOUPLOADER_SERVER_URL=https://upload.example.com
AUTOUPLOADER_SERVER_TOKEN=

# Manual license activation (full Supabase Edge Function URL and public Ed25519 JWK).
SUPABASE_LICENSE_URL=https://PROJECT_REF.supabase.co/functions/v1/license
LICENSE_SIGNING_PUBLIC_JWK={"crv":"Ed25519","x":"fFS6mV6AnmKsX3t5kJVdGmILhFe8xAP--PEA_uAg2YA","kty":"OKP"}
