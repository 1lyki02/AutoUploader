{
  "name": "@autouploader/telegram-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch src/index.ts\" \"vite --config web/vite.config.ts\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/index.ts",
    "start:prod": "pnpm build && tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@autouploader/shared": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "@twa-dev/sdk": "^8.0.2",
    "dotenv": "^16.6.1",
    "grammy": "^1.38.3",
    "hono": "^4.9.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
