# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user id админов через запятую (узнать у @userinfobot)
TELEGRAM_ADMIN_IDS=

# Тот же URL и токен, что в apps/admin/.env
SUPABASE_LICENSE_ADMIN_URL=https://PROJECT_REF.supabase.co/functions/v1/license-admin
LICENSE_ADMIN_TOKEN=

# Публичный HTTPS URL Mini App (обязателен для Telegram Web App)
# Прод: URL сервиса на Railway/VPS. Локально: cloudflared/ngrok на :8787 после build
# либо на Vite :5180 в режиме pnpm dev:telegram-admin
TELEGRAM_WEBAPP_URL=

# Альтернатива TELEGRAM_WEBAPP_URL (если тот пуст). На Railway можно не задавать —
# подставится https://$RAILWAY_PUBLIC_DOMAIN
# PUBLIC_URL=https://your-app.up.railway.app

# HTTP-порт API + статики (Railway/Render задают PORT сами)
# PORT=8787
